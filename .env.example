# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Admin login for the internal leads dashboard (/internal-leads-portal).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Used to sign the login session token. Any long random string works —
# changing it instantly logs everyone out.
JWT_SECRET=change-this-to-a-long-random-string

# Port the backend API server listens on.
PORT=4000
